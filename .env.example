# Database connection (Neon / PostgreSQL pooler connection URL)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/flowforge?sslmode=require"

# Direct database connection URL (Used for Prisma migrations & schema changes)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/flowforge?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="your_secure_random_secret_here"
BETTER_AUTH_URL="http://localhost:3000"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
